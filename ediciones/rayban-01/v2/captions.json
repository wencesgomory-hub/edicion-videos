    "texto": "No tienen como un proceso"
  },
  {
    "inicio": 23.938,
    "fin": 25.0,
    "texto": "claro, ¿entendés?"
  },
  {
    "inicio": 25.0,
    "fin": 26.0,
    "texto": "Claro."
  },
  {
    "inicio": 26.0,
    "fin": 28.1,
    "texto": "Cuando me mandaste para reservarlo..."
  },
  {
    "inicio": 28.1,
    "fin": 29.6,
    "texto": "Ya lo tenés armado."
  },
  {
    "inicio": 29.6,
    "fin": 31.903,
    "texto": "Sí, sí, lo tratamos de"
  },
  {
    "inicio": 31.903,
    "fin": 32.7,
    "texto": "manejar."
  },
  {
    "inicio": 32.7,
    "fin": 34.7,
    "texto": "Sí, el tema es que..."
  },
  {
    "inicio": 34.7,
    "fin": 36.272,
    "texto": "Lo voy a usar para"
  },
  {
    "inicio": 36.272,
    "fin": 36.6,
    "texto": "eso."
  },
  {
    "inicio": 36.6,
    "fin": 38.7,
    "texto": "La cámara, fijate que..."
  },
  {
    "inicio": 38.7,
    "fin": 41.733,
    "texto": "Es una locura lo que"
  },
  {
    "inicio": 41.733,
    "fin": 45.0,
    "texto": "la cámara está haciendo."
  },
  {
    "inicio": 45.0,
    "fin": 46.55,
    "texto": "Y la batería también dura"
  },
  {
    "inicio": 46.55,
    "fin": 47.2,
    "texto": "una locura."
  },
  {
    "inicio": 47.2,
    "fin": 48.848,
    "texto": "Al ser Max, también dura"
  },
  {
    "inicio": 48.848,
    "fin": 49.7,
    "texto": "un montonazo."
  },
  {
    "inicio": 52.1,
    "fin": 54.3,
    "texto": "Lo apago acá arriba."
  },
  {
    "inicio": 54.3,
    "fin": 56.6,
    "texto": "Y ahí va."
  },
  {
    "inicio": 56.6,
    "fin": 59.092,
    "texto": "Cualquier cosa de la configuración,"
  },
  {
    "inicio": 59.092,
    "fin": 60.712,
    "texto": "que te trabes o algo,"
  },
  {
    "inicio": 60.712,
    "fin": 61.46,
    "texto": "me mandás"
  },
  {
    "inicio": 61.46,
    "fin": 62.46,
    "texto": "un mensajito."
  },
  {
    "inicio": 62.46,
    "fin": 63.46,
    "texto": "No pasa nada."
  },
  {
    "inicio": 63.46,
    "fin": 64.502,
    "texto": "Te lo dejo acá. Si"
  },
  {
    "inicio": 64.502,
    "fin": 65.86,
    "texto": "querés, metelo acá adentro."
  },
  {
    "inicio": 66.0,
    "fin": 67.1,
    "texto": "La bolsita."
  },
  {
    "inicio": 67.1,
    "fin": 69.25,
    "texto": "Te guardo acá la garantía."
  },
  {
    "inicio": 69.25,
    "fin": 72.4,
    "texto": "La fundita."
  },
  {
    "inicio": 72.4,
    "fin": 74.3,
    "texto": "Ahí entró."
  },
  {
    "inicio": 78.0,
    "fin": 79.7,
    "texto": "Bueno, señor. Un gustazo."
  },
  {
    "inicio": 79.7,
    "fin": 81.2,
    "texto": "Nos estamos viendo."
  },
  {
    "inicio": 81.2,
    "fin": 83.2,
    "texto": "Cualquier cosita me decís."
  },
  {
    "inicio": 83.2,
    "fin": 84.473,
    "texto": "Dale, dale."
  }
