    "fin": 4.9,
    "texto": "Esta rayita..."
  },
  {
    "inicio": 4.9,
    "fin": 6.0,
    "texto": "¿Cuál?"
  },
  {
    "inicio": 15.0,
    "fin": 16.6,
    "texto": "¿Esto es cámara?"
  },
  {
    "inicio": 17.0,
    "fin": 19.1,
    "texto": "Un desastre cómo contestan..."
  },
  {
    "inicio": 19.1,
    "fin": 20.0,
    "texto": "Vos tenés..."
  },
  {
    "inicio": 20.0,
    "fin": 22.0,
